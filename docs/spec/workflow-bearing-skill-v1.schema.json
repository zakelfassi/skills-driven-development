{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skdd.dev/schemas/workflow-bearing-skill/v1",
  "title": "SkDD workflow-bearing skill v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skill", "outcome", "acceptance", "state", "evidence", "terminal_states"],
  "properties": {
    "schema": { "const": "https://skdd.dev/schemas/workflow-bearing-skill/v1" },
    "skill": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "target_required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "target_required": { "type": "boolean" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "resume_required"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "resume_required": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_schema", "independent_provider_required", "target_fields"],
      "properties": {
        "receipt_schema": { "const": "https://skdd.dev/schemas/proof-receipt/v1" },
        "independent_provider_required": { "type": "boolean" },
        "target_fields": {
          "type": "array",
          "const": ["environment", "resource", "revision"]
        }
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["verified", "refused", "blocked", "open"] }
    }
  }
}
